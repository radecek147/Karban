{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Karban",
  "version": "../package.json",
  "identifier": "io.github.radecek147.karban",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Karban",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1f2e4a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "CardGame",
    "shortDescription": "Hospodský roguelike se žolíky",
    "longDescription": "Česká karetní roguelike hra: pokerové kombinace, žolíci s pasivními efekty, Večerka mezi koly a osm pater útrat až k finálovému šéfovi.",
    "copyright": "Copyright (c) 2026 radecek147 and Karban contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "Czech"],
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  }
}
