{
  "name": "karban",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fetch-assets": "tsx scripts/fetch-assets.ts",
    "gen-textures": "tsx scripts/gen-textures.ts",
    "simulate": "tsx scripts/simulate.ts",
    "deploy": "npm run build && tsx scripts/deploy.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icon": "tsx scripts/desktop-icon.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/fraunces": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
